# Copie pra server/.env (gitignored). Credenciais do Cloudflare Realtime SFU:
# dashboard -> Realtime -> SFU -> crie um app e copie App ID e App Secret.
CF_SFU_APP_ID=
CF_SFU_APP_SECRET=

# Senha do grupo (bdk): mesmo valor de auth_password no config.toml de quem usa.
BDK_PASSWORD=

# Discord OAuth2 (Acesso restrito para membros do servidor BDK)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI=https://luce.codestage.pro/auth/discord/callback
